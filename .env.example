# JobFlow environment configuration
#
# PostgreSQL connection string for local development.
# Replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/jobflow"

# Docker Compose (docker-compose.yml) reads these to create the PostgreSQL
# container. Keep the password here in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=jobflow
